          <a class="blog-seguir__red" href={PERFIL_X} target="_blank" rel="noopener">
            <svg viewBox="1.25 2.25 21.57 19.50" aria-hidden="true"><path fill="currentColor" d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            <span>Seguir en X</span>
          </a>
        </div>
      </div>
    </section>
    <p class="blog-volver"><a href="/blog/">&larr; Volver al blog</a></p>
  </main>
  <script is:inline>
    // Copiar enlace del articulo. Sin dependencias; si el navegador no da permiso
    // al portapapeles, cae al metodo clasico de seleccion.
    document.querySelectorAll("[data-copiar-enlace]").forEach(function (btn) {
      btn.addEventListener("click", function () {
        var url = btn.getAttribute("data-copiar-enlace");
        var etiqueta = btn.querySelector("[data-copiar-texto]");
        var original = etiqueta ? etiqueta.textContent : "";
        function hecho() {
          if (etiqueta) etiqueta.textContent = "Enlace copiado";
          btn.classList.add("is-copiado");
          setTimeout(function () {
            if (etiqueta) etiqueta.textContent = original;
            btn.classList.remove("is-copiado");
          }, 2200);
        }
        if (navigator.clipboard && window.isSecureContext) {
          navigator.clipboard.writeText(url).then(hecho).catch(respaldo);
        } else {
          respaldo();
        }
        function respaldo() {
          var campo = document.createElement("textarea");
          campo.value = url;
          campo.setAttribute("readonly", "");
          campo.style.position = "fixed";
          campo.style.opacity = "0";
          document.body.appendChild(campo);
          campo.select();
          try { document.execCommand("copy"); hecho(); } catch (e) {}
          document.body.removeChild(campo);
        }
      });
    });
  </script>
  <SiteFooter />
</body>
</html>
