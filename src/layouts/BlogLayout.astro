    </section>
    {faq.length > 0 && (
      <section class="blog-faq" aria-label="Preguntas frecuentes">
        <h2>Preguntas frecuentes</h2>
        <div class="blog-faq__list">
          {faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </section>
    )}
    {fuentesParsed.length > 0 && (
      <section class="blog-fuentes" aria-label="Fuentes oficiales">
        <div class="blog-fuentes__box">
          <b>Fuentes oficiales</b>
          <ul>
            {fuentesParsed.map((f) => (
              <li>{f.url ? <a href={f.url} target="_blank" rel="noopener">{f.nombre}</a> : f.nombre}</li>
            ))}
          </ul>
        </div>
      </section>
    )}
    <div class="blog-cta">
      <div class="blog-cta__box">
        <h2>{ctaBox.titulo}</h2>
        <p>{ctaBox.texto}</p>
        <a class="blog-cta__btn" href={ctaBox.href}>{ctaBox.label}</a>
      </div>
    </div>
    {otros.length > 0 && (
      <section class="blog-related" aria-label="Sigue leyendo">
        <h2>Sigue leyendo</h2>
        <div class="blog-related__grid">
          {otros.map((p) => (
            <a class="blog-related__card" href={`/blog/${p.id}/`}>
              <span class="blog-related__meta">{p.data.fecha.toLocaleDateString('es-ES', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
              <b>{p.data.titulo}</b>
              <span class="blog-related__go">Leer el artículo &rarr;</span>
            </a>
          ))}
        </div>
      </section>
    )}
    <section class="blog-seguir" aria-label="Síguenos en redes">
      <div class="blog-seguir__box">
        <b>Novedades del RGPD y del AI Act, explicadas</b>
        <p>Publicamos análisis de lo que cambia y de lo que obliga de verdad, sin alarmismo y sin jerga. Si es tu ámbito, te leemos por aquí.</p>
        <div class="blog-seguir__redes">
          <a class="blog-seguir__red" href={PERFIL_LINKEDIN} target="_blank" rel="noopener">
            <svg viewBox="3.28 3.31 17.17 17.14" aria-hidden="true"><path fill="currentColor" d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.56V9h3.56v11.45z"/></svg>
            <span>Seguir en LinkedIn</span>
          </a>
          <a class="blog-seguir__red" href={PERFIL_INSTAGRAM} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.43.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.43.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41-.56-.22-.96-.48-1.38-.9-.42-.42-.68-.82-.9-1.38-.16-.43-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.43-.16 1.06-.36 2.23-.41 1.27-.06 1.65-.07 4.85-.07M12 0C8.74 0 8.33.01 7.05.07 5.78.13 4.9.33 4.14.63a5.87 5.87 0 0 0-2.13 1.38A5.87 5.87 0 0 0 .63 4.14c-.3.76-.5 1.64-.56 2.91C.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.26 2.15.56 2.91.31.79.72 1.46 1.38 2.13a5.87 5.87 0 0 0 2.13 1.38c.76.3 1.64.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.27-.06 2.15-.26 2.91-.56a5.87 5.87 0 0 0 2.13-1.38 5.87 5.87 0 0 0 1.38-2.13c.3-.76.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.15-.56-2.91a5.87 5.87 0 0 0-1.38-2.13A5.87 5.87 0 0 0 19.86.63c-.76-.3-1.64-.5-2.91-.56C15.67.01 15.26 0 12 0Zm0 5.84A6.16 6.16 0 1 0 18.16 12 6.16 6.16 0 0 0 12 5.84Zm0 10.16A4 4 0 1 1 16 12a4 4 0 0 1-4 4Zm7.85-10.4a1.44 1.44 0 1 1-1.44-1.44 1.44 1.44 0 0 1 1.44 1.44Z"/></svg>
            <span>Seguir en Instagram</span>
